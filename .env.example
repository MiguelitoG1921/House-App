# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real secrets.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# --- Better Auth ---
# Generate a secret with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# The URL your app runs at (use your Vercel URL in production)
BETTER_AUTH_URL=http://localhost:3000

# --- Greenhouse shared access ---
# Make a private code and share it only with cooperative members.
HOUSEHOLD_ACCESS_CODE=replace-with-a-private-household-code
# Use a random value of at least 32 characters. Keep this secret on the server.
HOUSEHOLD_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# --- Supabase Postgres (used by Drizzle, server-side only) ---
# Supabase dashboard → Connect → "Transaction pooler" (port 6543).
# Used by the running app. Pair with `prepare: false` in the postgres client.
DATABASE_URL=postgresql://postgres.ppfedgipheubcotxrpsn:YOUR_DATABASE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase dashboard → Connect → "Session pooler" (port 5432).
# Used only by drizzle-kit for migrations.
DATABASE_URL_SESSION=postgresql://postgres.ppfedgipheubcotxrpsn:YOUR_DATABASE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
