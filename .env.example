# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real secrets.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# --- Better Auth ---
# Generate a secret with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# The URL your app runs at (use your Vercel URL in production)
BETTER_AUTH_URL=http://localhost:3000

# --- Supabase Postgres (used by Drizzle, server-side only) ---
# Supabase dashboard → Connect → "Transaction pooler" (port 6543).
# Used by the running app. Pair with `prepare: false` in the postgres client.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Supabase dashboard → Connect → "Session pooler" (port 5432).
# Used only by drizzle-kit for migrations.
DATABASE_URL_SESSION=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
